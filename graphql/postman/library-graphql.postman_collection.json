                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"mutation { createAuthor(id: 5002, name: \\\"Demo\\\", surname: \\\"Author\\\") { id name surname } createPublisher(id: 5003, name: \\\"Demo Press\\\") { id name } }\"\n}",
