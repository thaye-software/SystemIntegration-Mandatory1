                                    "    pm.expect(body.data.createAuthor).to.eql({ id: 5002, name: \"Demo\", surname: \"Author\" });",
                                    "});",
                                    "pm.test(\"Publisher 5003 is Demo Press\", () => {",
                                    "    pm.expect(body.data.createPublisher).to.eql({ id: 5003, name: \"Demo Press\" });",
                                    "});"
                                ]
