{
    "info": {
        "name": "Library GraphQL API",
        "description": "GraphQL API for the library. This collection follows section \"2 demo in browser\" in graphql/README_GRAPHQL.txt and no other steps.\n\nEvery operation is a POST to {{baseUrl}} with Content-Type: application/json and a JSON body {\"query\": \"...\"}.\nApplication errors stay HTTP 200. The code is errors[0].extensions.code (VALIDATION, NOT_FOUND, or CONFLICT) and data is null.\n\nThe service must already be running at http://127.0.0.1:8001/graphql.\nRun the whole collection with the Collection Runner and keep the folder order.\nIds are the ones in the demo: book 5001, author 5002, publisher 5003.\nThe last two folders delete those rows and check they are gone.\nA finished run leaves library.db as it was.\nIf a run stopped early, run folder \"9. Cleanup\" before starting again.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://127.0.0.1:8001/graphql"
        }
    ],
    "event": [
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                    "pm.test(\"Response is JSON\", () => {",
                    "    pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"json\");",
                    "});"
                ]
            }
        }
    ],
    "item": [
        {
            "name": "1. List",
            "description": "List what is already there. Nothing is written.",
            "item": [
                {
                    "name": "List authors and publishers",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const body = pm.response.json();",
                                    "pm.test(\"No GraphQL errors\", () => pm.expect(body.errors || []).to.eql([]));",
                                    "pm.test(\"Authors and publishers are listed\", () => {",
                                    "    pm.expect(body.data.authors).to.be.an(\"array\");",
                                    "    pm.expect(body.data.publishers).to.be.an(\"array\");",
                                    "});"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"query { authors { id name surname } publishers { id name } }\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}",
                            "host": [
                                "{{baseUrl}}"
                            ]
                        }
                    }
                },
                {
                    "name": "List books",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
