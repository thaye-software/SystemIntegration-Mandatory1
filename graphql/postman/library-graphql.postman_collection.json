                                    "pm.test(\"No GraphQL errors\", () => pm.expect(body.errors || []).to.eql([]));",
                                    "pm.test(\"Books are listed\", () => pm.expect(body.data.books).to.be.an(\"array\"));"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"query { books { id title authorId publishingCompanyId publishingYear } }\"\n}",
                            "options": {
                                "raw": {
